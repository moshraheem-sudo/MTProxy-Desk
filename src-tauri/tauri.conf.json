{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "MTProxy Desk",
  "version": "1.0.0",
  "identifier": "com.mtproxydesk.client",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "MTProxy Desk v1.0.0 – Dev: Mohammed Shaheed Al-Aajeebi",
        "width": 840,
        "height": 580,
        "minWidth": 700,
        "minHeight": 460,
        "resizable": true,
        "fullscreen": false,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "resources": [
      "WebView2Loader.dll"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
